# ──────────────────────────────────────────────────────────
# Avino — пример переменных окружения. Скопируйте в .env.
# Никаких реальных секретов в этом файле (см. CLAUDE.md §3 code style).
# ──────────────────────────────────────────────────────────

# ── Node ──
NODE_ENV=development

# ── API (apps/api) ──
API_PORT=4000

# ── PostgreSQL + PostGIS ──
POSTGRES_USER=avino
POSTGRES_PASSWORD=avino
POSTGRES_DB=avino
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://avino:avino@localhost:5432/avino?schema=public

# ── Redis (cache + BullMQ) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── S3-compatible storage ──
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=avino-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Yandex Maps ──
YANDEX_MAPS_API_KEY=

# ── Eskiz.uz (SMS) ──
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api

# ── Translation (Google или Yandex Translate) ──
TRANSLATE_PROVIDER=yandex
TRANSLATE_API_KEY=

# ── SMTP / email ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@avino.uz

# ── Web (apps/web) ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
