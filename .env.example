# ──────────────────────────────────────────────────────────
# Avino — пример переменных окружения. Скопируйте в .env.
# Никаких реальных секретов в этом файле (см. CLAUDE.md §3 code style).
#
# Валидация на старте: apps/api/src/config/env.validation.ts (TASK-022).
# Обязательные группы: PostgreSQL (DATABASE_URL), Redis (REDIS_URL).
# Остальные группы (S3, Yandex, Eskiz, Translate, SMTP) опциональны на старте
# и заполняются по мере подключения соответствующих сервисов.
# ──────────────────────────────────────────────────────────

# ── Node ──
NODE_ENV=development

# ── API (apps/api) ──
API_PORT=4000

# ── PostgreSQL + PostGIS ──
POSTGRES_USER=avino
POSTGRES_PASSWORD=avino
POSTGRES_DB=avino
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://avino:avino@localhost:5432/avino?schema=public

# ── Redis (cache + BullMQ) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── S3-compatible storage ──
# Пусто → нативный AWS S3; задан → S3-compatible (MinIO/DigitalOcean Spaces).
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=avino-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# path-style адресация. true для MinIO/Spaces; "false" для нативного AWS S3.
S3_FORCE_PATH_STYLE=true
# Если задан публичный URL/CDN — объекты заливаются public-read и getObjectUrl
# отдаёт прямой публичный URL. Если пусто — приватный bucket + presigned GET URL.
S3_PUBLIC_BASE_URL=
# TTL presigned GET URL в секундах (используется только для приватного bucket).
S3_SIGNED_URL_TTL=3600

# ── Yandex Maps ──
YANDEX_MAPS_API_KEY=

# ── Eskiz.uz (SMS) ──
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
# Alphanumeric/short-code отправителя. По умолчанию тестовый «4546».
ESKIZ_FROM=4546

# ── Translation (Google или Yandex Translate) ──
# Авто-перевод объявлений после APPROVE→ACTIVE через BullMQ `translation_queue`
# (TASK-071). Провайдер выбирается TRANSLATE_PROVIDER (yandex|google). Без
# TRANSLATE_API_KEY провайдер мягко деградирует (возвращает исходный текст).
TRANSLATE_PROVIDER=yandex
TRANSLATE_API_KEY=
# Только для Yandex Cloud Translate (Api-Key авторизация):
TRANSLATE_FOLDER_ID=
# Очередь перевода: число попыток (ретраи) и параллелизм воркера.
TRANSLATE_QUEUE_ATTEMPTS=3
TRANSLATE_QUEUE_CONCURRENCY=2

# ── Истечение промо VIP/TOP (TASK-123, promotion_queue) ──
# Фоновый sweep ACTIVE-промо с expires_at <= now() → EXPIRED. Все значения имеют
# дефолты. Поиск и так трактует истёкшую промо как NORMAL в SQL (ADR-0004),
# джоба лишь приводит ledger/read-cache в покой и ставит уведомление владельцу.
PROMOTION_EXPIRY_CRON=* * * * *
PROMOTION_EXPIRY_CONCURRENCY=1
PROMOTION_EXPIRY_BATCH_SIZE=100

# ── Saved-search алерты (TASK-102, saved_search_queue) ──
# Polling-матчер: периодически перепроверяет активные сохранённые поиски и ставит
# дедуплицированные алерты (in-app + дайджест-email) по объявлениям, ставшим
# ACTIVE с прошлой проверки (по published_at / last_checked_at). Все значения
# имеют дефолты. Алерты не требуют минутной срочности — дефолт каждые 5 минут.
SAVED_SEARCH_ALERT_CRON=*/5 * * * *
SAVED_SEARCH_ALERT_CONCURRENCY=1
SAVED_SEARCH_ALERT_BATCH_SIZE=100
SAVED_SEARCH_ALERT_MAX_LISTINGS=50

# ── SMTP / email (TASK-101, email_queue) ──
# Доставка email асинхронна через BullMQ `email_queue` (воркер выполняет SMTP-
# отправку и логирует результат). Без SMTP_HOST в dev письмо логируется, в
# production не отправляется. EMAIL_QUEUE_* имеют дефолты.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@avino.uz
EMAIL_QUEUE_ATTEMPTS=3
EMAIL_QUEUE_CONCURRENCY=2

# ── OTP / rate limiting (TASK-041, ENV.md §8; все значения имеют дефолты) ──
OTP_TTL=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# ── JWT / auth (TASK-042, ENV.md §7) ──
# СЕКРЕТЫ обязательны и без дефолтов: приложение не стартует, если они пусты.
# Сгенерировать РАЗНЫЕ значения: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ── Web (apps/web) ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
