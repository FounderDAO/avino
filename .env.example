# ──────────────────────────────────────────────────────────
# Avino — пример переменных окружения. Скопируйте в .env.
# Никаких реальных секретов в этом файле (см. CLAUDE.md §3 code style).
#
# Валидация на старте: apps/api/src/config/env.validation.ts (TASK-022).
# Обязательные группы: PostgreSQL (DATABASE_URL), Redis (REDIS_URL).
# Остальные группы (S3, Yandex, Eskiz, Translate, SMTP) опциональны на старте
# и заполняются по мере подключения соответствующих сервисов.
# ──────────────────────────────────────────────────────────

# ── Node ──
NODE_ENV=development

# ── API (apps/api) ──
API_PORT=4000

# ── PostgreSQL + PostGIS ──
POSTGRES_USER=avino
POSTGRES_PASSWORD=avino
POSTGRES_DB=avino
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://avino:avino@localhost:5432/avino?schema=public

# ── Redis (cache + BullMQ) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── S3-compatible storage ──
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=avino-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Yandex Maps ──
YANDEX_MAPS_API_KEY=

# ── Eskiz.uz (SMS) ──
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
# Alphanumeric/short-code отправителя. По умолчанию тестовый «4546».
ESKIZ_FROM=4546

# ── Translation (Google или Yandex Translate) ──
TRANSLATE_PROVIDER=yandex
TRANSLATE_API_KEY=

# ── SMTP / email ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@avino.uz

# ── OTP / rate limiting (TASK-041, ENV.md §8; все значения имеют дефолты) ──
OTP_TTL=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# ── JWT / auth (TASK-042, ENV.md §7) ──
# СЕКРЕТЫ обязательны и без дефолтов: приложение не стартует, если они пусты.
# Сгенерировать РАЗНЫЕ значения: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ── Web (apps/web) ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
