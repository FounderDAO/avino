# ── Node ──
NODE_ENV=development

# ── API ──
API_PORT=4000

# ── CORS ──
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── PostgreSQL + PostGIS (обязательно) ──
DATABASE_URL=postgresql://avino:avino@localhost:5432/avino

# ── Redis (обязательно) ──
REDIS_URL=redis://localhost:6379

# ── JWT (обязательно; никаких дефолтов для секретов) ──
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ── S3-compatible storage (Cloudflare R2 / MinIO) ──
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
S3_SIGNED_URL_TTL=3600
# S3_KEY_PREFIX=dev

# ── Yandex Maps ──
YANDEX_MAPS_API_KEY=

# ── Eskiz.uz / SMS ──
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_BASE_URL=https://notify.eskiz.uz
ESKIZ_FROM=4546
# ESKIZ_ENABLED=true

# ── Translation ──
TRANSLATE_PROVIDER=yandex
TRANSLATE_API_KEY=
TRANSLATE_FOLDER_ID=

# ── Google Sign-In ──
GOOGLE_CLIENT_ID=

# ── Sign in with Apple ──
APPLE_CLIENT_ID=

# ── Telegram admin-алерты ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# TELEGRAM_INCLUDE_OTP_CODE=true
# TELEGRAM_NOTIFICATION_STATE=true

# ── OTP / rate limiting ──
OTP_TTL=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# ── SMTP / email ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@avino.uz
EMAIL_QUEUE_ATTEMPTS=3
EMAIL_QUEUE_CONCURRENCY=2

# ── Продвижение объявлений ──
# PROMOTION_ENABLED=false
# PROMOTION_EXPIRY_CRON=* * * * *
# PROMOTION_EXPIRY_CONCURRENCY=1
# PROMOTION_EXPIRY_BATCH_SIZE=100

# ── Saved-search алерты ──
# SAVED_SEARCH_ALERT_CRON=*/5 * * * *
# SAVED_SEARCH_ALERT_CONCURRENCY=1
# SAVED_SEARCH_ALERT_BATCH_SIZE=100
# SAVED_SEARCH_ALERT_MAX_LISTINGS=50

# ── Exchange rate / cbu.uz ──
# EXCHANGE_RATE_CRON=0 6 * * *
# EXCHANGE_RATE_TZ=Asia/Tashkent
# CBU_BASE_URL=https://cbu.uz

# ── Media cleanup (деструктивно, default OFF) ──
# MEDIA_CLEANUP_ENABLED=true
# MEDIA_CLEANUP_CRON=0 4 * * *
# MEDIA_CLEANUP_GRACE_HOURS=24
# MEDIA_CLEANUP_BATCH_SIZE=500
# MEDIA_CLEANUP_DRY_RUN=true
# MEDIA_CLEANUP_MAX_DELETE_RATIO=0.5

# ── Firebase Admin SDK / FCM push (ADR-0102, опционально — config-gated) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY содержит \n — вставлять как одну строку с литеральными \n
FIREBASE_PRIVATE_KEY=

# ── Notification delivery / диспетчер (ADR-0102) ──
# NOTIFICATIONS_EMAIL_ENABLED=true
# NOTIFICATIONS_PUSH_ENABLED=true
# NOTIFICATION_DISPATCH_CRON=*/1 * * * *
# NOTIFICATION_DISPATCH_LOOKBACK_MIN=60
# NOTIFICATION_DISPATCH_BATCH=200
# NOTIFICATION_DISPATCH_CONCURRENCY=1
# EMAIL_CHAT_THROTTLE_MIN=30

# ── Публичный URL портала (для deep-link в email/push) ──
APP_PUBLIC_URL=https://avino.uz

# ── Swagger / OpenAPI UI ──
# SWAGGER_ENABLED=true
# SWAGGER_USER=admin
# SWAGGER_PASS=change_me
