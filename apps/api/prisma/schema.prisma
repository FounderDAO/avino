// Базовая Prisma-схема Avino.
// Геоданные — через PostGIS (CLAUDE.md §12): postgisExtensions + расширение geography.
// Модели предметной области (User, Listing, Chat, ...) добавляются в отдельных задачах.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, postgis, pg_trgm]
}

// Базовые enum'ы предметной области (TASK-032, см. DB_SCHEMA.md §3, API.md).
// Значения enum — часть v1-контракта: добавление значения non-breaking,
// переименование/удаление — breaking (требует v2). Значения совпадают с
// shared/src/enums.ts и с JSON-контрактом API (UPPERCASE).
// Роли (Role) НЕ являются Postgres enum — это сидируемый справочник `roles`
// (DB_SCHEMA.md §4, ADR-0008/ADR-011), поэтому здесь enum Role отсутствует.

/// Статусы объявления. Moderation flow: NEW → ACTIVE | DRAFT | REJECTED | DELETED.
enum ListingStatus {
  NEW
  ACTIVE
  DRAFT
  REJECTED
  DELETED
  ARCHIVED
  SOLD
  RENTED
}

/// Типы продвижения объявления. Приоритет: VIP > TOP > NORMAL (ADR-0004).
enum PromotionType {
  NORMAL
  TOP
  VIP
}

/// Тип сделки по объявлению (DB_SCHEMA.md §3). Создаётся как Postgres enum
/// этой миграцией — listings первой ссылается на него (TASK-035).
enum TransactionType {
  SALE
  RENT
}

/// Тип недвижимости (DB_SCHEMA.md §3). Значения совпадают с контрактом §3;
/// NEW_BUILDING присутствует в БД-контракте (расхождение с packages/shared
/// фиксируется отдельной задачей — см. DONE.md TASK-035).
enum PropertyType {
  APARTMENT
  HOUSE
  NEW_BUILDING
  LAND
  COMMERCIAL
}

/// Валюты. FX-конвертации в MVP нет (DB_SCHEMA.md §2).
enum Currency {
  UZS
  USD
}

/// Языки интерфейса и объявлений. В API значения UPPERCASE; lowercase uz|ru|en —
/// только конвенция заголовка Accept-Language/?lang (API.md, ADR-0008).
enum Language {
  UZ
  RU
  EN
}

/// Статусы пользователя (DB_SCHEMA.md §3). ACTIVE → DELETED — это soft-delete.
/// BLOCKED — это НЕ DELETED, поэтому заблокированный аккаунт продолжает
/// резервировать свой phone/email.
enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

/// Канал доставки OTP-кода (DB_SCHEMA.md §3/§4). LOGIN — единственная цель в MVP.
enum OtpChannel {
  SMS
  EMAIL
}

/// Назначение OTP-кода. В MVP только LOGIN; значения расширяются без breaking
/// change (verify-контакт, сброс и т.п. — будущие задачи).
enum OtpPurpose {
  LOGIN
}

/// Источник перевода объявления (DB_SCHEMA.md §3, ADR-005). USER — авторский
/// оригинал на original_language (is_auto_translated=false); GOOGLE/YANDEX —
/// машинный автоперевод, генерируемый после перехода объявления в ACTIVE.
enum TranslationSource {
  USER
  GOOGLE
  YANDEX
}

/// Тип медиа объявления (DB_SCHEMA.md §3). В MVP только IMAGE; VIDEO — Phase 2,
/// поэтому здесь намеренно одно значение (добавление VIDEO — non-breaking).
enum MediaType {
  IMAGE
}

// users — ядро identity (DB_SCHEMA.md §4).
// Пароля нет: авторизация по OTP (ARCHITECTURE §6, TASK-034).
// phone/email НАМЕРЕННО не @unique: уникальность ограничена не-DELETED
// аккаунтами через PARTIAL UNIQUE индексы в raw SQL (Variant A — ADR-013,
// DB_SCHEMA.md §14), чтобы soft-deleted аккаунт освобождал контакт для
// повторной регистрации, сохраняя значение на удалённой строке.
// CHECK-ограничения (phone OR email; deleted_at iff DELETED) тоже добавляются
// raw SQL — Prisma не умеет выразить ни то, ни другое (DB_SCHEMA.md §15).
model User {
  id              String     @id @default(uuid()) @db.Uuid
  phone           String?    @db.VarChar(20)
  email           String?    @db.VarChar(255)
  isPhoneVerified Boolean    @default(false) @map("is_phone_verified")
  isEmailVerified Boolean    @default(false) @map("is_email_verified")
  status          UserStatus @default(ACTIVE)
  defaultLanguage Language   @default(RU) @map("default_language")
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile       UserProfile?
  roles         UserRole[]     @relation("UserRoleHolder")
  grantedRoles  UserRole[]     @relation("UserRoleGranter")
  otpCodes      OtpCode[]
  refreshTokens RefreshToken[]
  listings      Listing[]

  @@map("users")
}

// user_profiles — 1:1 с users (DB_SCHEMA.md §4).
model UserProfile {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  firstName         String?   @map("first_name") @db.VarChar(100)
  lastName          String?   @map("last_name") @db.VarChar(100)
  displayName       String?   @map("display_name") @db.VarChar(150)
  avatarUrl         String?   @map("avatar_url")
  contactPhone      String?   @map("contact_phone") @db.VarChar(20)
  preferredLanguage Language? @map("preferred_language")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// roles — сидируемый справочник (DB_SCHEMA.md §4). `code` — один из кодов из §3
// (USER|OWNER|AGENT|AGENCY|LANDLORD|PROPERTY_MANAGER|MODERATOR|ADMIN). GUEST
// намеренно отсутствует — это неявное состояние неаутентифицированного запроса
// (ADR-0008/ADR-011). Роли расширяются без миграции — поэтому таблица, а не enum.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(40)
  description String?

  users UserRole[]

  @@map("roles")
}

// user_roles — many-to-many user<->role (пользователь может иметь несколько
// ролей, ADR-011). granted_by — админ, назначивший роль (nullable; SET NULL,
// чтобы назначение пережило удаление назначавшего).
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User  @relation("UserRoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  role          Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedByUser User? @relation("UserRoleGranter", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// otp_codes — одноразовые коды для OTP-логина (DB_SCHEMA.md §4, ADR-0010).
// code_hash хранит ХЕШ кода, не plaintext. user_id nullable: код может быть
// выписан до того, как пользователь создан (pre-signup login flow). attempts —
// счётчик неуспешных верификаций для rate-limit/локаута. Запрос и проверка OTP
// rate-limited (per destination, per IP) — на уровне сервиса.
model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  channel     OtpChannel
  destination String     @db.VarChar(255)
  purpose     OtpPurpose @default(LOGIN)
  codeHash    String     @map("code_hash") @db.VarChar(255)
  attempts    Int        @default(0) @db.SmallInt
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([destination, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

// refresh_tokens — refresh-токены сессий (DB_SCHEMA.md §4, ADR-0010).
// token_hash хранит ХЕШ токена, не plaintext; токен ротируется при использовании.
// family_id группирует токены одной сессии: повторное использование уже
// ротированного токена отзывает всю family (reuse detection) — логика в сервисе.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  familyId  String    @map("family_id") @db.Uuid
  userAgent String?   @map("user_agent")
  ip        String?   @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Объявление о недвижимости (DB_SCHEMA.md §6). Нетранслируемые структурные
/// поля живут здесь; переводимый текст — в listing_translations (TASK-036).
///
/// Гео (ADR-0003, DB_SCHEMA §14): latitude/longitude — редактируемый источник
/// координат (Decimal). location — производная `geography(Point,4326)`, которую
/// Prisma не умеет читать/писать (Unsupported); она синхронизируется триггером
/// БД из lat/lng, а GIST-индекс по ней создаётся raw SQL миграцией.
///
/// promotion_* — денормализованный READ CACHE активной строки listing_promotions
/// (источник истины — TASK-037, ADR-0004). Здесь это просто кэш для сортировки.
///
/// owner_id → users ON DELETE RESTRICT: аккаунт-владелец не удаляется физически
/// (soft-delete, ADR-013), поэтому объявления сохраняют ссылку на создателя.
/// agency_id / city_id / district_id — это FK по DB_SCHEMA §6, но таблицы
/// agencies/cities/districts ещё не созданы. Колонки заводятся как UUID-скаляры
/// с индексами; реальные FK-ограничения и relation-поля добавятся, когда
/// появятся целевые таблицы (отдельные задачи).
model Listing {
  id                 String                                 @id @default(uuid()) @db.Uuid
  ownerId            String                                 @map("owner_id") @db.Uuid
  agencyId           String?                                @map("agency_id") @db.Uuid
  transactionType    TransactionType                        @map("transaction_type")
  propertyType       PropertyType                           @map("property_type")
  status             ListingStatus                          @default(NEW)
  originalLanguage   Language                               @map("original_language")
  price              Decimal                                @db.Decimal(14, 2)
  currency           Currency
  area               Decimal?                               @db.Decimal(10, 2)
  rooms              Int?                                   @db.SmallInt
  floor              Int?                                   @db.SmallInt
  totalFloors        Int?                                   @map("total_floors") @db.SmallInt
  yearBuilt          Int?                                   @map("year_built") @db.SmallInt
  address            String?                                @db.VarChar(500)
  cityId             String?                                @map("city_id") @db.Uuid
  districtId         String?                                @map("district_id") @db.Uuid
  latitude           Decimal?                               @db.Decimal(9, 6)
  longitude          Decimal?                               @db.Decimal(9, 6)
  // PostGIS не имеет нативного типа в Prisma — derived, см. шапку модели/ADR-0003.
  location           Unsupported("geography(Point, 4326)")?
  promotionType      PromotionType                          @default(NORMAL) @map("promotion_type")
  promotionStartedAt DateTime?                              @map("promotion_started_at") @db.Timestamptz(6)
  promotionExpiresAt DateTime?                              @map("promotion_expires_at") @db.Timestamptz(6)
  publishedAt        DateTime?                              @map("published_at") @db.Timestamptz(6)
  createdAt          DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner        User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  translations ListingTranslation[]
  media        ListingMedia[]

  @@index([status])
  @@index([propertyType])
  @@index([transactionType])
  @@index([price])
  @@index([cityId])
  @@index([districtId])
  @@index([ownerId])
  @@index([agencyId])
  @@index([promotionType])
  @@index([promotionExpiresAt])
  // Композитный индекс дефолтной выдачи поиска (DB_SCHEMA §6):
  // status → promotion_type → created_at desc → id desc.
  @@index([status, promotionType, createdAt(sort: Desc), id(sort: Desc)])
  @@map("listings")
}

/// Переводы объявления (DB_SCHEMA.md §6, ADR-005). Весь переводимый текст
/// (title/description/address_note/features_text) живёт здесь, а не в listings.
/// Авторская строка на original_language — source=USER, is_auto_translated=false;
/// машинные строки (GOOGLE/YANDEX) генерируются после ACTIVE и наследуют
/// видимость/статус объявления — самостоятельно не публикуются.
/// UNIQUE(listing_id, language): один перевод на язык. ON DELETE CASCADE —
/// переводы не переживают удаление объявления (listings — soft-delete по status,
/// физическое удаление строки забирает и переводы).
model ListingTranslation {
  id               String            @id @default(uuid()) @db.Uuid
  listingId        String            @map("listing_id") @db.Uuid
  language         Language
  title            String            @db.VarChar(255)
  description      String?
  addressNote      String?           @map("address_note")
  featuresText     String?           @map("features_text")
  source           TranslationSource
  isAutoTranslated Boolean           @default(false) @map("is_auto_translated")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, language])
  @@index([listingId])
  @@map("listing_translations")
}

/// Медиа объявления (DB_SCHEMA.md §6, ADR-008). Файлы лежат в S3-совместимом
/// хранилище — в БД только URL и метаданные. sort_order задаёт порядок показа
/// в галерее (индекс (listing_id, sort_order)). mime_type фиксирует
/// провалидированный content-type загруженного файла (разрешённые в MVP:
/// image/jpeg, image/png, image/webp — DB_SCHEMA §6); width/height/size_bytes —
/// метаданные обработанного изображения. EXIF/GPS вырезается при обработке;
/// координаты объявления берутся только с карты, никогда из EXIF фото.
/// ON DELETE CASCADE — медиа не переживает физическое удаление объявления.
model ListingMedia {
  id           String    @id @default(uuid()) @db.Uuid
  listingId    String    @map("listing_id") @db.Uuid
  url          String
  thumbnailUrl String?   @map("thumbnail_url")
  sortOrder    Int       @default(0) @map("sort_order") @db.SmallInt
  type         MediaType @default(IMAGE)
  mimeType     String?   @map("mime_type") @db.VarChar(100)
  width        Int?
  height       Int?
  sizeBytes    Int?      @map("size_bytes")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("listing_media")
}
