// Базовая Prisma-схема Avino.
// Геоданные — через PostGIS (CLAUDE.md §12): postgisExtensions + расширение geography.
// Модели предметной области (User, Listing, Chat, ...) добавляются в отдельных задачах.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, postgis, pg_trgm]
}

// Базовые enum'ы предметной области (TASK-032, см. DB_SCHEMA.md §3, API.md).
// Значения enum — часть v1-контракта: добавление значения non-breaking,
// переименование/удаление — breaking (требует v2). Значения совпадают с
// shared/src/enums.ts и с JSON-контрактом API (UPPERCASE).
// Роли (Role) НЕ являются Postgres enum — это сидируемый справочник `roles`
// (DB_SCHEMA.md §4, ADR-0008/ADR-011), поэтому здесь enum Role отсутствует.

/// Статусы объявления. Moderation flow: NEW → ACTIVE | DRAFT | REJECTED | DELETED.
enum ListingStatus {
  NEW
  ACTIVE
  DRAFT
  REJECTED
  DELETED
  ARCHIVED
  SOLD
  RENTED
}

/// Типы продвижения объявления. Приоритет: VIP > TOP > NORMAL (ADR-0004).
enum PromotionType {
  NORMAL
  TOP
  VIP
}

/// Тип сделки по объявлению (DB_SCHEMA.md §3). Создаётся как Postgres enum
/// этой миграцией — listings первой ссылается на него (TASK-035).
enum TransactionType {
  SALE
  RENT
}

/// Тип недвижимости (DB_SCHEMA.md §3). Значения совпадают с контрактом §3;
/// NEW_BUILDING присутствует в БД-контракте (расхождение с packages/shared
/// фиксируется отдельной задачей — см. DONE.md TASK-035).
enum PropertyType {
  APARTMENT
  HOUSE
  NEW_BUILDING
  LAND
  COMMERCIAL
}

/// Валюты. FX-конвертации в MVP нет (DB_SCHEMA.md §2).
enum Currency {
  UZS
  USD
}

/// Источник курса валют: CBU — официальный курс ЦБУ (получен автоматически),
/// MANUAL — ручной оверрайд администратора.
enum ExchangeRateSource {
  CBU
  MANUAL
}

/// Языки интерфейса и объявлений. В API значения UPPERCASE; lowercase uz|ru|en —
/// только конвенция заголовка Accept-Language/?lang (API.md, ADR-0008).
enum Language {
  UZ
  RU
  EN
}

/// Статусы пользователя (DB_SCHEMA.md §3). ACTIVE → DELETED — это soft-delete.
/// BLOCKED — это НЕ DELETED, поэтому заблокированный аккаунт продолжает
/// резервировать свой phone/email.
enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

/// Канал доставки OTP-кода (DB_SCHEMA.md §3/§4). LOGIN — единственная цель в MVP.
enum OtpChannel {
  SMS
  EMAIL
}

/// Назначение OTP-кода. В MVP только LOGIN; значения расширяются без breaking
/// change (verify-контакт, сброс и т.п. — будущие задачи).
enum OtpPurpose {
  LOGIN
}

/// Источник перевода объявления (DB_SCHEMA.md §3, ADR-005). USER — авторский
/// оригинал на original_language (is_auto_translated=false); GOOGLE/YANDEX —
/// машинный автоперевод, генерируемый после перехода объявления в ACTIVE.
enum TranslationSource {
  USER
  GOOGLE
  YANDEX
}

/// Тип медиа объявления (DB_SCHEMA.md §3). В MVP только IMAGE; VIDEO — Phase 2,
/// поэтому здесь намеренно одно значение (добавление VIDEO — non-breaking).
enum MediaType {
  IMAGE
}

/// Статус жалобы на объявление (DB_SCHEMA.md §3/§7, API.md §16, TASK-132).
/// Flow: NEW (создана пользователем) → IN_REVIEW (взята в работу) →
/// RESOLVED (нарушение подтверждено/устранено) | REJECTED (жалоба отклонена).
/// Значения — часть v1-контракта (добавление non-breaking, переименование —
/// breaking, см. CLAUDE.md §14); совпадают с union на фронте (adminTypes.ts).
enum ComplaintStatus {
  NEW
  IN_REVIEW
  RESOLVED
  REJECTED
}

/// Статус строки продвижения в ledger'е listing_promotions (DB_SCHEMA.md §3/§8,
/// ADR-0004). PENDING_PAYMENT — создана, ждёт оплаты/ручной активации; ACTIVE —
/// действует (ровно одна на объявление, partial unique); EXPIRED — срок вышел;
/// CANCELLED — снята админом; REFUNDED — возврат (Phase 1.5+, когда появятся
/// онлайн-платежи). Статус ≠ payment_status: в MVP активация ручная и оплата
/// NOT_REQUIRED.
enum PromotionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  REFUNDED
}

/// Статус оплаты продвижения (DB_SCHEMA.md §3/§8, ADR-0004). В MVP онлайн-оплаты
/// нет — админ активирует VIP/TOP вручную со статусом NOT_REQUIRED. Остальные
/// значения заведены заранее для forward-совместимости с платёжным провайдером
/// (Phase 1.5); добавление значения — non-breaking (ADR-0008).
enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// Действия администратора над продвижением, фиксируемые в promotion_logs
/// (DB_SCHEMA.md §3/§8, ADR-0004). Аудит ручных операций VIP/TOP.
enum PromotionAdminAction {
  ACTIVATE_VIP
  ACTIVATE_TOP
  CANCEL_PROMOTION
  EXTEND_PROMOTION
}

/// Действие модерации над объявлением, фиксируемое в moderation_logs
/// (DB_SCHEMA.md §7, API.md §16, TASK-053). Маппинг на listing_status:
/// APPROVE → ACTIVE, SEND_TO_DRAFT → DRAFT, REJECT → REJECTED, DELETE → DELETED.
/// Добавление нового действия — non-breaking (ADR-0008).
enum ModerationAction {
  APPROVE
  SEND_TO_DRAFT
  REJECT
  DELETE
}

/// Тип уведомления (DB_SCHEMA.md §3/§11, TASK-038). Доменное событие, по которому
/// порождается notification. Добавление нового типа — non-breaking (ADR-0008).
enum NotificationType {
  SAVED_SEARCH_NEW_LISTING
  FAVORITE_PRICE_DROP
  NEW_CHAT_MESSAGE
  LISTING_MODERATION_STATUS_CHANGED
  NEW_LEAD
  PROMOTION_ACTIVATED
  PROMOTION_EXPIRED
  TOUR_REQUEST_STATUS_CHANGED
}

/// Канал доставки уведомления (DB_SCHEMA.md §3/§11). В MVP надёжно доставляются
/// EMAIL + IN_APP; PUSH — заглушка под Flutter-приложение (notification_devices).
enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP
}

/// Статус доставки уведомления (DB_SCHEMA.md §3/§11). PENDING — поставлено в
/// очередь BullMQ; SENT — отправлено каналом; FAILED — доставка не удалась;
/// READ — прочитано пользователем (для IN_APP).
enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

/// Статусы заявки на тур (TASK tour-requests). PENDING → CONFIRMED|DECLINED
/// (решение владельца) | CANCELLED (отмена покупателем). DECLINED/CANCELLED — терминальны.
enum TourRequestStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

/// Платформа устройства для push-токенов (DB_SCHEMA.md §3/§11, ADR-0010). PUSH-
/// транспорт (FCM/APNs) подключается при интеграции Flutter-приложения; таблица
/// существует заранее, чтобы контракт был стабилен.
enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

// users — ядро identity (DB_SCHEMA.md §4).
// Пароля нет: авторизация по OTP (ARCHITECTURE §6, TASK-034).
// phone/email НАМЕРЕННО не @unique: уникальность ограничена не-DELETED
// аккаунтами через PARTIAL UNIQUE индексы в raw SQL (Variant A — ADR-013,
// DB_SCHEMA.md §14), чтобы soft-deleted аккаунт освобождал контакт для
// повторной регистрации, сохраняя значение на удалённой строке.
// CHECK-ограничения (phone OR email; deleted_at iff DELETED) тоже добавляются
// raw SQL — Prisma не умеет выразить ни то, ни другое (DB_SCHEMA.md §15).
model User {
  id              String     @id @default(uuid()) @db.Uuid
  phone           String?    @db.VarChar(20)
  email           String?    @db.VarChar(255)
  isPhoneVerified Boolean    @default(false) @map("is_phone_verified")
  isEmailVerified Boolean    @default(false) @map("is_email_verified")
  status          UserStatus @default(ACTIVE)
  defaultLanguage Language   @default(RU) @map("default_language")
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile              UserProfile?
  roles                UserRole[]           @relation("UserRoleHolder")
  grantedRoles         UserRole[]           @relation("UserRoleGranter")
  otpCodes             OtpCode[]
  refreshTokens        RefreshToken[]
  listings             Listing[]
  // Продвижения, запрошенные пользователем (FK SET NULL — переживают удаление
  // запросившего; промо-строка живёт со своим объявлением).
  promotionsRequested  ListingPromotion[]   @relation("PromotionRequester")
  // Действия над продвижениями, совершённые этим пользователем как админом.
  promotionLogsAsAdmin PromotionLog[]       @relation("PromotionLogAdmin")
  // Действия модерации, совершённые этим пользователем как модератором (TASK-053).
  moderationLogs       ModerationLog[]      @relation("ModerationLogModerator")
  // Жалобы (TASK-132): поданные пользователем и обработанные им как модератором.
  complaintsReported   Complaint[]          @relation("ComplaintReporter")
  complaintsHandled    Complaint[]          @relation("ComplaintHandler")
  // Вовлечённость (TASK-038).
  favorites            Favorite[]
  savedSearches        SavedSearch[]
  // Чат-треды: как инициатор (написал создателю) и как владелец объявления.
  chatThreadsInitiated ChatThread[]         @relation("ChatInitiator")
  chatThreadsOwned     ChatThread[]         @relation("ChatOwner")
  // Сообщения, отправленные пользователем (FK SET NULL — переживают удаление).
  chatMessages         ChatMessage[]
  notifications        Notification[]
  notificationDevices  NotificationDevice[]
  // Записи аудита, где этот пользователь — actor (FK SET NULL; null = system).
  auditLogs            AuditLog[]
  tourRequests  TourRequest[]

  @@map("users")
}

// user_profiles — 1:1 с users (DB_SCHEMA.md §4).
model UserProfile {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  firstName         String?   @map("first_name") @db.VarChar(100)
  lastName          String?   @map("last_name") @db.VarChar(100)
  displayName       String?   @map("display_name") @db.VarChar(150)
  avatarUrl         String?   @map("avatar_url")
  contactPhone      String?   @map("contact_phone") @db.VarChar(20)
  preferredLanguage Language? @map("preferred_language")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// roles — сидируемый справочник (DB_SCHEMA.md §4). `code` — один из кодов из §3
// (USER|OWNER|AGENT|AGENCY|LANDLORD|PROPERTY_MANAGER|MODERATOR|ADMIN). GUEST
// намеренно отсутствует — это неявное состояние неаутентифицированного запроса
// (ADR-0008/ADR-011). Роли расширяются без миграции — поэтому таблица, а не enum.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(40)
  description String?

  users UserRole[]

  @@map("roles")
}

// user_roles — many-to-many user<->role (пользователь может иметь несколько
// ролей, ADR-011). granted_by — админ, назначивший роль (nullable; SET NULL,
// чтобы назначение пережило удаление назначавшего).
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User  @relation("UserRoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  role          Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedByUser User? @relation("UserRoleGranter", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// otp_codes — одноразовые коды для OTP-логина (DB_SCHEMA.md §4, ADR-0010).
// code_hash хранит ХЕШ кода, не plaintext. user_id nullable: код может быть
// выписан до того, как пользователь создан (pre-signup login flow). attempts —
// счётчик неуспешных верификаций для rate-limit/локаута. Запрос и проверка OTP
// rate-limited (per destination, per IP) — на уровне сервиса.
model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  channel     OtpChannel
  destination String     @db.VarChar(255)
  purpose     OtpPurpose @default(LOGIN)
  codeHash    String     @map("code_hash") @db.VarChar(255)
  attempts    Int        @default(0) @db.SmallInt
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([destination, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

// refresh_tokens — refresh-токены сессий (DB_SCHEMA.md §4, ADR-0010).
// token_hash хранит ХЕШ токена, не plaintext; токен ротируется при использовании.
// family_id группирует токены одной сессии: повторное использование уже
// ротированного токена отзывает всю family (reuse detection) — логика в сервисе.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  familyId  String    @map("family_id") @db.Uuid
  userAgent String?   @map("user_agent")
  ip        String?   @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Объявление о недвижимости (DB_SCHEMA.md §6). Нетранслируемые структурные
/// поля живут здесь; переводимый текст — в listing_translations (TASK-036).
///
/// Гео (ADR-0003, DB_SCHEMA §14): latitude/longitude — редактируемый источник
/// координат (Decimal). location — производная `geography(Point,4326)`, которую
/// Prisma не умеет читать/писать (Unsupported); она синхронизируется триггером
/// БД из lat/lng, а GIST-индекс по ней создаётся raw SQL миграцией.
///
/// promotion_* — денормализованный READ CACHE активной строки listing_promotions
/// (источник истины — TASK-037, ADR-0004). Здесь это просто кэш для сортировки.
///
/// owner_id → users ON DELETE RESTRICT: аккаунт-владелец не удаляется физически
/// (soft-delete, ADR-013), поэтому объявления сохраняют ссылку на создателя.
/// agency_id / city_id / district_id — это FK по DB_SCHEMA §6, но таблицы
/// agencies/cities/districts ещё не созданы. Колонки заводятся как UUID-скаляры
/// с индексами; реальные FK-ограничения и relation-поля добавятся, когда
/// появятся целевые таблицы (отдельные задачи).
model Listing {
  id                 String                                 @id @default(uuid()) @db.Uuid
  ownerId            String                                 @map("owner_id") @db.Uuid
  agencyId           String?                                @map("agency_id") @db.Uuid
  transactionType    TransactionType                        @map("transaction_type")
  propertyType       PropertyType                           @map("property_type")
  status             ListingStatus                          @default(NEW)
  originalLanguage   Language                               @map("original_language")
  price              Decimal                                @db.Decimal(14, 2)
  currency           Currency
  area               Decimal?                               @db.Decimal(10, 2)
  rooms              Int?                                   @db.SmallInt
  floor              Int?                                   @db.SmallInt
  totalFloors        Int?                                   @map("total_floors") @db.SmallInt
  yearBuilt          Int?                                   @map("year_built") @db.SmallInt
  address            String?                                @db.VarChar(500)
  cityId             String?                                @map("city_id") @db.Uuid
  districtId         String?                                @map("district_id") @db.Uuid
  latitude           Decimal?                               @db.Decimal(9, 6)
  longitude          Decimal?                               @db.Decimal(9, 6)
  // PostGIS не имеет нативного типа в Prisma — derived, см. шапку модели/ADR-0003.
  location           Unsupported("geography(Point, 4326)")?
  promotionType      PromotionType                          @default(NORMAL) @map("promotion_type")
  promotionStartedAt DateTime?                              @map("promotion_started_at") @db.Timestamptz(6)
  promotionExpiresAt DateTime?                              @map("promotion_expires_at") @db.Timestamptz(6)
  publishedAt        DateTime?                              @map("published_at") @db.Timestamptz(6)
  editedSinceHidden  Boolean                                @default(false) @map("edited_since_hidden")
  // Приём туров (просмотров): флаг + окна доступного времени (JSONB-массив
  // [{ "start": "07:00", "end": "10:00" }]). tours_enabled=false → заявки не
  // принимаются; окна — общие, локальное Asia/Tashkent.
  toursEnabled       Boolean                                @default(false) @map("tours_enabled")
  tourWindows        Json                                   @default("[]") @map("tour_windows")
  createdAt          DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner          User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  translations   ListingTranslation[]
  media          ListingMedia[]
  promotions     ListingPromotion[]
  promotionLogs  PromotionLog[]
  moderationLogs ModerationLog[]
  favorites      Favorite[]
  chatThreads    ChatThread[]
  complaints     Complaint[]
  tourRequests   TourRequest[]

  @@index([status])
  @@index([propertyType])
  @@index([transactionType])
  @@index([price])
  @@index([cityId])
  @@index([districtId])
  @@index([ownerId])
  @@index([agencyId])
  @@index([promotionType])
  @@index([promotionExpiresAt])
  // Композитный индекс дефолтной выдачи поиска (DB_SCHEMA §6):
  // status → promotion_type → created_at desc → id desc.
  @@index([status, promotionType, createdAt(sort: Desc), id(sort: Desc)])
  @@map("listings")
}

/// Переводы объявления (DB_SCHEMA.md §6, ADR-005). Весь переводимый текст
/// (title/description/address_note/features_text) живёт здесь, а не в listings.
/// Авторская строка на original_language — source=USER, is_auto_translated=false;
/// машинные строки (GOOGLE/YANDEX) генерируются после ACTIVE и наследуют
/// видимость/статус объявления — самостоятельно не публикуются.
/// UNIQUE(listing_id, language): один перевод на язык. ON DELETE CASCADE —
/// переводы не переживают удаление объявления (listings — soft-delete по status,
/// физическое удаление строки забирает и переводы).
model ListingTranslation {
  id               String            @id @default(uuid()) @db.Uuid
  listingId        String            @map("listing_id") @db.Uuid
  language         Language
  title            String            @db.VarChar(255)
  description      String?
  addressNote      String?           @map("address_note")
  featuresText     String?           @map("features_text")
  source           TranslationSource
  isAutoTranslated Boolean           @default(false) @map("is_auto_translated")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, language])
  @@index([listingId])
  @@map("listing_translations")
}

/// Медиа объявления (DB_SCHEMA.md §6, ADR-008). Файлы лежат в S3-совместимом
/// хранилище — в БД только URL и метаданные. sort_order задаёт порядок показа
/// в галерее (индекс (listing_id, sort_order)). mime_type фиксирует
/// провалидированный content-type загруженного файла (разрешённые в MVP:
/// image/jpeg, image/png, image/webp — DB_SCHEMA §6); width/height/size_bytes —
/// метаданные обработанного изображения. EXIF/GPS вырезается при обработке;
/// координаты объявления берутся только с карты, никогда из EXIF фото.
/// ON DELETE CASCADE — медиа не переживает физическое удаление объявления.
model ListingMedia {
  id           String    @id @default(uuid()) @db.Uuid
  listingId    String    @map("listing_id") @db.Uuid
  url          String
  /// Стабильный S3/R2 object key файла. Source of truth для отдачи: presigned URL
  /// генерируется из него на лету ПРИ КАЖДОМ ЧТЕНИИ (ADR-0086), поэтому ссылка не
  /// успевает протухнуть. Раньше в `url` хранился целиком presigned URL с TTL=1ч →
  /// после истечения фото отдавали 403 ExpiredRequest везде (деталь, модерация,
  /// форма редактирования). Nullable: legacy-строки (key=NULL) подписываются через
  /// extractKey(url)-фолбэк, поэтому миграция не требует бэкфилла.
  storageKey   String?   @map("storage_key")
  thumbnailUrl String?   @map("thumbnail_url")
  sortOrder    Int       @default(0) @map("sort_order") @db.SmallInt
  type         MediaType @default(IMAGE)
  mimeType     String?   @map("mime_type") @db.VarChar(100)
  width        Int?
  height       Int?
  sizeBytes    Int?      @map("size_bytes")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("listing_media")
}

/// Продвижение объявления — SOURCE OF TRUTH / ledger (DB_SCHEMA.md §8, ADR-0004).
/// Денормализованные listings.promotion_* — это лишь READ CACHE активной строки;
/// источник истины здесь. type хранит только платный тариф (TOP | VIP); NORMAL
/// означает «без промо» и в ledger не пишется. period_days ∈ {7,14,30}
/// (CHECK добавляется raw SQL — Prisma этого не умеет, DB_SCHEMA §15).
///
/// Не более ОДНОГО ACTIVE-продвижения на объявление: PARTIAL UNIQUE (listing_id)
/// WHERE status='ACTIVE' (raw SQL — §8/§15). payment_reference — ключ
/// идемпотентности для будущих платёжных колбэков: PARTIAL UNIQUE WHERE NOT NULL.
/// В MVP активация ручная (payment_status=NOT_REQUIRED, payment_provider —
/// заглушка); платёжные поля заведены заранее для forward-совместимости (ADR-0004).
///
/// listing_id → listings ON DELETE CASCADE (промо не переживает физическое
/// удаление объявления). user_id → users ON DELETE SET NULL, nullable —
/// продвижение остаётся в истории, даже если запросивший аккаунт удалён.
model ListingPromotion {
  id               String          @id @default(uuid()) @db.Uuid
  listingId        String          @map("listing_id") @db.Uuid
  userId           String?         @map("user_id") @db.Uuid
  type             PromotionType
  status           PromotionStatus @default(PENDING_PAYMENT)
  periodDays       Int             @map("period_days") @db.SmallInt
  startsAt         DateTime?       @map("starts_at") @db.Timestamptz(6)
  expiresAt        DateTime?       @map("expires_at") @db.Timestamptz(6)
  price            Decimal?        @db.Decimal(14, 2)
  currency         Currency?
  paymentStatus    PaymentStatus   @default(NOT_REQUIRED) @map("payment_status")
  paymentProvider  String?         @map("payment_provider") @db.VarChar(40)
  paymentReference String?         @map("payment_reference") @db.VarChar(120)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User?          @relation("PromotionRequester", fields: [userId], references: [id], onDelete: SetNull)
  logs    PromotionLog[]

  @@index([listingId])
  @@index([status])
  @@index([expiresAt])
  @@map("listing_promotions")
}

/// Аудит админских действий над продвижением (DB_SCHEMA.md §8). Отдельный
/// доменный журнал в дополнение к audit_logs (TASK-038). Хранит дельту
/// type/expires_at до и после действия и причину.
///
/// listing_promotion_id → listing_promotions ON DELETE SET NULL, nullable:
/// запись аудита переживает удаление самой промо-строки. listing_id → listings
/// ON DELETE CASCADE. admin_id → users ON DELETE SET NULL, nullable — лог
/// сохраняется, даже если аккаунт админа удалён.
model PromotionLog {
  id                 String               @id @default(uuid()) @db.Uuid
  listingPromotionId String?              @map("listing_promotion_id") @db.Uuid
  listingId          String               @map("listing_id") @db.Uuid
  adminId            String?              @map("admin_id") @db.Uuid
  action             PromotionAdminAction
  oldType            PromotionType?       @map("old_type")
  newType            PromotionType?       @map("new_type")
  oldExpiresAt       DateTime?            @map("old_expires_at") @db.Timestamptz(6)
  newExpiresAt       DateTime?            @map("new_expires_at") @db.Timestamptz(6)
  reason             String?
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  listingPromotion ListingPromotion? @relation(fields: [listingPromotionId], references: [id], onDelete: SetNull)
  listing          Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  admin            User?             @relation("PromotionLogAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([listingPromotionId])
  @@index([adminId])
  @@map("promotion_logs")
}

/// Редактируемая админом матрица тарифов продвижения (TOP/VIP × 7/14/30 дней).
/// Фиксированный набор из 6 строк гарантируется unique-индексом и CHECK-ограничениями
/// в миграции. Сидируется значениями текущего хардкод-каталога (promotions.catalog.ts).
model PromotionPlan {
  id         String        @id @default(uuid()) @db.Uuid
  type       PromotionType
  periodDays Int           @map("period_days") @db.SmallInt
  price      Decimal       @db.Decimal(14, 2)
  currency   Currency      @default(UZS)
  isActive   Boolean       @default(true) @map("is_active")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([type, periodDays])
  @@map("promotion_plans")
}

/// Универсальный key/value-справочник настроек приложения. Первое значение —
/// интервал cron для истечения продвижений (promotion_expiry_cron).
model AppSetting {
  key       String   @id @db.VarChar(80)
  value     String   @db.VarChar(255)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

/// Журнал модерации объявлений (DB_SCHEMA.md §7, API.md §16, TASK-053). Каждое
/// действие модератора над объявлением логируется здесь (доменный лог) — в
/// дополнение к audit_logs(LISTING_STATUS_CHANGE). old_status/new_status
/// фиксируют переход; reason — опциональная причина (например для REJECT).
///
/// listing_id → listings ON DELETE CASCADE: лог не переживает физического
/// удаления объявления. moderator_id → users ON DELETE SET NULL, nullable —
/// запись сохраняется, даже если аккаунт модератора удалён (null = система).
model ModerationLog {
  id          String           @id @default(uuid()) @db.Uuid
  listingId   String           @map("listing_id") @db.Uuid
  moderatorId String?          @map("moderator_id") @db.Uuid
  action      ModerationAction
  oldStatus   ListingStatus?   @map("old_status")
  newStatus   ListingStatus?   @map("new_status")
  reason      String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  moderator User?   @relation("ModerationLogModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([moderatorId])
  @@index([createdAt])
  @@map("moderation_logs")
}

/// Жалоба на объявление (DB_SCHEMA.md §7, API.md §16, TASK-132). USER жалуется
/// на листинг (`POST /complaints`); MODERATOR/ADMIN разбирают (`GET/PATCH
/// /admin/complaints`). handled_by/handled_at проставляются при первой и
/// последующих сменах статуса (кто и когда обработал последним).
///
/// listing_id NOT NULL + ON DELETE CASCADE (DB_SCHEMA §7): жалоба всегда про
/// листинг и не переживает его физическое удаление (как moderation_logs/favorites/
/// listing_translations — единый паттерн дочерних таблиц листинга). На чтении
/// DELETED-листинги уже не существуют. reporter_id / handled_by → users ON DELETE
/// SET NULL, nullable: жалоба остаётся в истории, даже если аккаунт автора или
/// обработавшего удалён.
model Complaint {
  id         String          @id @default(uuid()) @db.Uuid
  listingId  String          @map("listing_id") @db.Uuid
  reporterId String?         @map("reporter_id") @db.Uuid
  reason     String          @db.VarChar(120)
  details    String?
  status     ComplaintStatus @default(NEW)
  handledBy  String?         @map("handled_by") @db.Uuid
  handledAt  DateTime?       @map("handled_at") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter User?   @relation("ComplaintReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  handler  User?   @relation("ComplaintHandler", fields: [handledBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([listingId])
  @@map("complaints")
}

/// Избранное (DB_SCHEMA.md §9, TASK-038). Один пользователь — одна строка на
/// объявление: UNIQUE(user_id, listing_id) запрещает дубли. GUEST не может
/// добавлять в избранное (неявное состояние, не персистится — ADR-0011).
/// DELETED-объявления отфильтровываются на чтении, а не удаляются отсюда.
/// Обе стороны ON DELETE CASCADE — строка не переживает удаление ни пользователя,
/// ни объявления.
model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("favorites")
}

/// Сохранённый поиск (DB_SCHEMA.md §9, ADR-0009). filters_json ВЕРСИОНИРОВАН:
/// { "schemaVersion": <int>, "filters": { ... } } — матчер толерантен к старым
/// версиям (forward-миграция), чтобы сохранённые поиски не ломались при эволюции
/// параметров поиска. MVP: polling-матчер по last_checked_at эмитит
/// дедуплицированные алерты по объявлениям, ставшим ACTIVE с прошлой проверки.
/// ON DELETE CASCADE — поиск принадлежит пользователю.
model SavedSearch {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  name          String    @db.VarChar(150)
  filtersJson   Json      @map("filters_json")
  isActive      Boolean   @default(true) @map("is_active")
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("saved_searches")
}

/// Чат-тред между инициатором и владельцем объявления (DB_SCHEMA.md §10,
/// ADR-0003). Имена полей — initiator_id / owner_id, НЕ buyer/seller: объявление
/// может быть SALE или RENT. UNIQUE(listing_id, initiator_id, owner_id) — один
/// тред на пару+объявление. GUEST не может начать тред; новый тред не создаётся
/// на DELETED-объявлении (правило на уровне сервиса). last_message_at —
/// денормализованный курсор для сортировки списка тредов. Все FK ON DELETE
/// CASCADE.
model ChatThread {
  id            String    @id @default(uuid()) @db.Uuid
  listingId     String    @map("listing_id") @db.Uuid
  initiatorId   String    @map("initiator_id") @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  initiator User          @relation("ChatInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  owner     User          @relation("ChatOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@unique([listingId, initiatorId, ownerId])
  @@index([listingId])
  @@index([initiatorId])
  @@index([ownerId])
  @@index([lastMessageAt])
  @@map("chat_threads")
}

/// Сообщение чата (DB_SCHEMA.md §10). MVP использует API-polling; WebSocket
/// добавляется позже без изменения схемы. thread_id ON DELETE CASCADE; sender_id
/// ON DELETE SET NULL (nullable) — сообщение сохраняется в истории треда, даже
/// если аккаунт отправителя физически удалён. is_read — флаг прочтения адресатом.
model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  threadId  String   @map("thread_id") @db.Uuid
  senderId  String?  @map("sender_id") @db.Uuid
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User?      @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

/// Уведомление пользователю (DB_SCHEMA.md §11). Все уведомления порождаются как
/// BullMQ-джобы — никогда не отправляются синхронно внутри обработчика запроса.
/// data_json хранит ссылки на сущности (listing_id, thread_id и т.п.). status
/// дефолтит в PENDING (поставлено в очередь). ON DELETE CASCADE — уведомление
/// принадлежит пользователю.
model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      NotificationType
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  title     String?             @db.VarChar(255)
  body      String?
  dataJson  Json?               @map("data_json")
  readAt    DateTime?           @map("read_at") @db.Timestamptz(6)
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([type])
  @@map("notifications")
}

/// Доставка уведомления по каналу (ADR-0102). Таблица отслеживает статус
/// email/push-доставки отдельно от in-app фида. Уникальность по
/// (notification_id, channel) гарантирует идемпотентность fan-out.
model NotificationDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String              @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  attempts       Int                 @default(0)
  lastError      String?             @map("last_error")
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

/// Реестр push-токенов (DB_SCHEMA.md §11, ADR-0010). Заглушка под MVP: PUSH-
/// транспорт (FCM Android / APNs iOS) подключается при интеграции Flutter-
/// приложения; таблица существует заранее, чтобы контракт был стабилен.
/// UNIQUE(push_token) — один токен на устройство глобально. ON DELETE CASCADE.
model NotificationDevice {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  platform   DevicePlatform
  pushToken  String         @map("push_token") @db.VarChar(512)
  isActive   Boolean        @default(true) @map("is_active")
  lastSeenAt DateTime?      @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pushToken])
  @@index([userId])
  @@map("notification_devices")
}

/// Справочник районов для разрешения `district_id` листингов в читаемое название
/// (ADR-0068, TASK-209). Автономная модель без FK/relation на `listings` — FK будет
/// добавлен позже, когда данные листингов будут мигрированы на реальные id районов.
/// `code` — slug-ключ (уникальный, latin lowercase); trilingual NOT NULL name.
/// 12 районов Ташкента сидируются в миграции (фиксированные UUID d0000000-*).
model District {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(40)
  nameUz    String   @map("name_uz") @db.VarChar(120)
  nameRu    String   @map("name_ru") @db.VarChar(120)
  nameEn    String   @map("name_en") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("districts")
}

/// Общий журнал аудита для security-чувствительных действий (DB_SCHEMA.md §12,
/// ADR-0004) — в дополнение к доменным логам (moderation_logs, promotion_logs).
/// action — free-form varchar (расширяемый, НЕ enum), поэтому новые
/// аудируемые действия не требуют миграции (LOGIN, ROLE_CHANGE,
/// LISTING_STATUS_CHANGE, ...). actor_id ON DELETE SET NULL, nullable
/// (null = система) — запись аудита переживает удаление актора.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String?  @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.Uuid
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Курс валют (USD→UZS). «Текущий курс» = последняя строка по fetchedAt.
/// История — все строки. Ручной оверрайд = строка с source=MANUAL.
model ExchangeRate {
  id        String             @id @default(uuid()) @db.Uuid
  base      Currency
  quote     Currency
  rate      Decimal            @db.Decimal(18, 6) // 1 base = rate quote (1 USD = rate UZS)
  source    ExchangeRateSource
  fetchedAt DateTime           @default(now()) @map("fetched_at") @db.Timestamptz(6)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([base, quote, fetchedAt(sort: Desc)])
  @@map("exchange_rates")
}

/// Заявка на тур (просмотр объявления). Хранит СНИМОК выбранного слота
/// (window_start/end, requested_date) и контактов покупателя (requester_name/phone),
/// чтобы правка окон продавцом не затрагивала историю. ON DELETE CASCADE — заявка
/// не переживает удаление объявления/пользователя.
model TourRequest {
  id             String            @id @default(uuid()) @db.Uuid
  listingId      String            @map("listing_id") @db.Uuid
  requesterId    String            @map("requester_id") @db.Uuid
  status         TourRequestStatus @default(PENDING)
  requestedDate  DateTime          @map("requested_date") @db.Date
  windowStart    String            @map("window_start")
  windowEnd      String            @map("window_end")
  requesterName  String            @map("requester_name")
  requesterPhone String            @map("requester_phone")
  message        String?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requester User    @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([requesterId])
  @@index([status])
