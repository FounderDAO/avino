// Базовая Prisma-схема Avino.
// Геоданные — через PostGIS (CLAUDE.md §12): postgisExtensions + расширение geography.
// Модели предметной области (User, Listing, Chat, ...) добавляются в отдельных задачах.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, postgis, pg_trgm]
}

// Базовые enum'ы предметной области (TASK-032, см. DB_SCHEMA.md §3, API.md).
// Значения enum — часть v1-контракта: добавление значения non-breaking,
// переименование/удаление — breaking (требует v2). Значения совпадают с
// shared/src/enums.ts и с JSON-контрактом API (UPPERCASE).
// Роли (Role) НЕ являются Postgres enum — это сидируемый справочник `roles`
// (DB_SCHEMA.md §4, ADR-0008/ADR-011), поэтому здесь enum Role отсутствует.

/// Статусы объявления. Moderation flow: NEW → ACTIVE | DRAFT | REJECTED | DELETED.
enum ListingStatus {
  NEW
  ACTIVE
  DRAFT
  REJECTED
  DELETED
  ARCHIVED
  SOLD
  RENTED
}

/// Типы продвижения объявления. Приоритет: VIP > TOP > NORMAL (ADR-0004).
enum PromotionType {
  NORMAL
  TOP
  VIP
}

/// Валюты. FX-конвертации в MVP нет (DB_SCHEMA.md §2).
enum Currency {
  UZS
  USD
}

/// Языки интерфейса и объявлений. В API значения UPPERCASE; lowercase uz|ru|en —
/// только конвенция заголовка Accept-Language/?lang (API.md, ADR-0008).
enum Language {
  UZ
  RU
  EN
}

/// Статусы пользователя (DB_SCHEMA.md §3). ACTIVE → DELETED — это soft-delete.
/// BLOCKED — это НЕ DELETED, поэтому заблокированный аккаунт продолжает
/// резервировать свой phone/email.
enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

/// Канал доставки OTP-кода (DB_SCHEMA.md §3/§4). LOGIN — единственная цель в MVP.
enum OtpChannel {
  SMS
  EMAIL
}

/// Назначение OTP-кода. В MVP только LOGIN; значения расширяются без breaking
/// change (verify-контакт, сброс и т.п. — будущие задачи).
enum OtpPurpose {
  LOGIN
}

// users — ядро identity (DB_SCHEMA.md §4).
// Пароля нет: авторизация по OTP (ARCHITECTURE §6, TASK-034).
// phone/email НАМЕРЕННО не @unique: уникальность ограничена не-DELETED
// аккаунтами через PARTIAL UNIQUE индексы в raw SQL (Variant A — ADR-013,
// DB_SCHEMA.md §14), чтобы soft-deleted аккаунт освобождал контакт для
// повторной регистрации, сохраняя значение на удалённой строке.
// CHECK-ограничения (phone OR email; deleted_at iff DELETED) тоже добавляются
// raw SQL — Prisma не умеет выразить ни то, ни другое (DB_SCHEMA.md §15).
model User {
  id              String     @id @default(uuid()) @db.Uuid
  phone           String?    @db.VarChar(20)
  email           String?    @db.VarChar(255)
  isPhoneVerified Boolean    @default(false) @map("is_phone_verified")
  isEmailVerified Boolean    @default(false) @map("is_email_verified")
  status          UserStatus @default(ACTIVE)
  defaultLanguage Language   @default(RU) @map("default_language")
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile       UserProfile?
  roles         UserRole[]     @relation("UserRoleHolder")
  grantedRoles  UserRole[]     @relation("UserRoleGranter")
  otpCodes      OtpCode[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// user_profiles — 1:1 с users (DB_SCHEMA.md §4).
model UserProfile {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  firstName         String?   @map("first_name") @db.VarChar(100)
  lastName          String?   @map("last_name") @db.VarChar(100)
  displayName       String?   @map("display_name") @db.VarChar(150)
  avatarUrl         String?   @map("avatar_url")
  contactPhone      String?   @map("contact_phone") @db.VarChar(20)
  preferredLanguage Language? @map("preferred_language")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// roles — сидируемый справочник (DB_SCHEMA.md §4). `code` — один из кодов из §3
// (USER|OWNER|AGENT|AGENCY|LANDLORD|PROPERTY_MANAGER|MODERATOR|ADMIN). GUEST
// намеренно отсутствует — это неявное состояние неаутентифицированного запроса
// (ADR-0008/ADR-011). Роли расширяются без миграции — поэтому таблица, а не enum.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(40)
  description String?

  users UserRole[]

  @@map("roles")
}

// user_roles — many-to-many user<->role (пользователь может иметь несколько
// ролей, ADR-011). granted_by — админ, назначивший роль (nullable; SET NULL,
// чтобы назначение пережило удаление назначавшего).
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User  @relation("UserRoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  role          Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedByUser User? @relation("UserRoleGranter", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// otp_codes — одноразовые коды для OTP-логина (DB_SCHEMA.md §4, ADR-0010).
// code_hash хранит ХЕШ кода, не plaintext. user_id nullable: код может быть
// выписан до того, как пользователь создан (pre-signup login flow). attempts —
// счётчик неуспешных верификаций для rate-limit/локаута. Запрос и проверка OTP
// rate-limited (per destination, per IP) — на уровне сервиса.
model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  channel     OtpChannel
  destination String     @db.VarChar(255)
  purpose     OtpPurpose @default(LOGIN)
  codeHash    String     @map("code_hash") @db.VarChar(255)
  attempts    Int        @default(0) @db.SmallInt
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([destination, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

// refresh_tokens — refresh-токены сессий (DB_SCHEMA.md §4, ADR-0010).
// token_hash хранит ХЕШ токена, не plaintext; токен ротируется при использовании.
// family_id группирует токены одной сессии: повторное использование уже
// ротированного токена отзывает всю family (reuse detection) — логика в сервисе.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  familyId  String    @map("family_id") @db.Uuid
  userAgent String?   @map("user_agent")
  ip        String?   @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
  @@map("refresh_tokens")
}
