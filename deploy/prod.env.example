# ─────────────────────────────────────────────────────────────────────────────
# Avino — прод-добавки к .env (поверх .env.example).
# На сервере: скопируйте .env.example → .env, проставьте реальные значения,
# затем допишите блок ниже. Реальные секреты в репозиторий НЕ коммитим.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node ──
NODE_ENV=production

# ── Домены (для Caddy + CORS + публичного URL API в браузерном бандле) ──
DOMAIN_CLIENT=avino.uz
DOMAIN_ADMIN=admin.avino.uz
DOMAIN_API=api.avino.uz

# Контакт для Let's Encrypt (уведомления об истечении сертификатов).
ACME_EMAIL=admin@avino.uz

# ── PostgreSQL ──
# Сильный пароль обязателен: docker-compose.prod.yml падает, если он пуст/дефолт.
# Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=__CHANGE_ME__
# DATABASE_URL должен использовать тот же пароль (хост = сервис-имя `postgres`):
DATABASE_URL=postgresql://avino:__CHANGE_ME__@postgres:5432/avino?schema=public

# ── JWT (обязательны, без дефолтов; РАЗНЫЕ значения) ──
# openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── SMTP (вход по EMAIL-OTP завязан на доставку писем) ──
# Берите внешнего транзакционного провайдера (Amazon SES / Resend / Postmark):
# у Hetzner исходящая почта по умолчанию заблокирована.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@avino.uz

# ── Sentry error tracking (ADR-0129; опционально, но для прода настоятельно) ──
# DSN проекта avino-api. Пусто → Sentry выключен.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── S3-совместимое хранилище фото (Hetzner Object Storage / Spaces / MinIO) ──
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=avino-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Публичный CDN-URL бакета (если есть) — иначе отдаются presigned-ссылки:
S3_PUBLIC_BASE_URL=
